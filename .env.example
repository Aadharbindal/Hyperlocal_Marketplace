# ---------------------------------------------------------------------------
# Hyperlocal Marketplace - environment template
# Copy to .env (never commit real values). See ENVIRONMENT_VARIABLES.md.
# ---------------------------------------------------------------------------

# ----- Global -----
APP_ENV=local                       # local | staging | production
BRAND_NAME=Hyperlocal Marketplace

# ----- API service (apps/api) -----
API_PORT=4000
API_HOST=0.0.0.0
API_JWT_SECRET=change-me-min-32-chars-random-string-please
API_JWT_ISSUER=hyperlocal-api
API_ACCESS_TOKEN_TTL_SECONDS=3600
API_REFRESH_TOKEN_TTL_SECONDS=2592000
API_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
API_LOG_LEVEL=info

# Data mode: memory (in-process demo store) | postgres
DATA_MODE=memory
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ----- Supabase (used when DATA_MODE=postgres) -----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never ship to mobile

# ----- Adapters: each accepts "mock" for local/demo mode -----
SMS_PROVIDER=mock                    # mock | msg91 | twilio
SMS_API_KEY=
SMS_SENDER_ID=

PAYMENT_PROVIDER=mock                # mock | razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Support console: a second factor for ADMIN/SUPPORT. Must be true in production.
ADMIN_MFA_REQUIRED=false

MAPS_PROVIDER=mock                   # mock | google | mapbox
MAPS_API_KEY=

PUSH_PROVIDER=mock                   # mock | expo | fcm
PUSH_SERVER_KEY=

TELEPHONY_PROVIDER=mock              # mock | exotel | knowlarity
TELEPHONY_API_KEY=
TELEPHONY_API_TOKEN=

STORAGE_PROVIDER=mock                # mock | supabase | s3
STORAGE_BUCKET=job-media
STORAGE_SIGNED_URL_TTL_SECONDS=900

ERROR_MONITORING_PROVIDER=mock       # mock | sentry
ERROR_MONITORING_DSN=

ANALYTICS_PROVIDER=mock              # mock | posthog
ANALYTICS_KEY=

# ----- OTP policy -----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5
OTP_DEMO_CODE=123456                 # mock SMS only; ignored in production

# ----- Pilot zone -----
PILOT_CITY=Delhi
PILOT_CENTER_LAT=28.6139
PILOT_CENTER_LNG=77.2090
PILOT_RADIUS_KM=3

# ----- Mobile app (apps/mobile) - EXPO_PUBLIC_* only, no secrets -----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
