# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo

# env / secrets - never commit real values
.env
.env.*
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# os
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# supabase local
supabase/.branches
supabase/.temp
supabase/.env

# coverage
coverage/

# local data for demo mode
apps/api/.data/

# Local editor/tooling config
.claude/

# Generated by `expo prebuild` and regenerated on every build - continuous native generation
# means `app.config.ts` is the source of truth, and a committed copy silently stops matching it.
apps/mobile/android/
apps/mobile/ios/
